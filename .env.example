# The only database setting: the app, migrations and the Prisma CLI all use it.
# Write any # in the password as %23.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@your-db-host:5432/wapzen?schema=public"

# Clerk: sk_live_... in production. The webhook secret comes from the
# endpoint pointing at POST /api/webhooks/clerk on the same Clerk instance.
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Chat replies (Claude Haiku 5.5). Unset = chat agents don't reply.
ANTHROPIC_API_KEY=sk-ant-...

# Voice-note transcription and knowledge base indexing. Without the rest of
# these the server still starts, but adding sources answers 503.
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=voice
PINECONE_INDEX_DIMENSION=3072
PINECONE_INDEX_HOST=https://your-index.svc.your-region.pinecone.io

# Request, Nest and Baileys logs; off by default.
VERBOSE_LOGS=false
CORS_ALLOWED_ORIGINS=https://wapzen.io,http://localhost:3000,http://localhost:3005
