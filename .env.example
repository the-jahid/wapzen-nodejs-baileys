# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.chneqzsmjtuxcgbbbibq:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.chneqzsmjtuxcgbbbibq:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Clerk: sk_live_... in production. The webhook secret comes from the
# endpoint pointing at POST /api/webhooks/clerk on the same Clerk instance.
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Chat replies
ANTHROPIC_API_KEY=sk-ant-...

# Knowledge base indexing. Without these the server still starts, but adding
# sources answers 503.
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=voice
PINECONE_INDEX_DIMENSION=3072
PINECONE_INDEX_HOST=https://your-index.svc.your-region.pinecone.io

# Request, Nest and Baileys logs; off by default.
VERBOSE_LOGS=false
CORS_ALLOWED_ORIGINS=https://wapzen.io,http://localhost:3000,http://localhost:3005
